# Pixora Docker setup - copy to .env and fill in all <placeholders>.
# Required entries abort startup if unset. Optional entries are
# commented out and use their defaults unless uncommented.

# --- required: fill these in (compose aborts if unset) ---
SECRET_KEY=<generate-a-strong-django-secret-key>
DB_PASSWORD=<choose-a-strong-database-password>
DJANGO_ADMIN_USER=<admin-username>
DJANGO_ADMIN_EMAIL=<admin-email-address>
DJANGO_ADMIN_PASSWORD=<admin-password-min-8-chars>

# --- optional: host ports (defaults: 4200 / 8000, bound to 127.0.0.1) ---
#FRONTEND_PORT=4200

# --- optional: application settings (see docker-compose.yaml for defaults) ---
#DEBUG=False
#ALLOWED_HOSTS=localhost,127.0.0.1
#DB_NAME=pixora
#DB_USER=pixora
#CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
#MAX_IMAGE_SIZE_MB=5