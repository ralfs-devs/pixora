# --- required: fill these in (compose aborts if unset) ---
SECRET_KEY=<generate-a-strong-django-secret-key>
DB_PASSWORD=<choose-a-strong-database-password>
DJANGO_ADMIN_USER=<admin-username>
DJANGO_ADMIN_EMAIL=<admin-email-address>
DJANGO_ADMIN_PASSWORD=<admin-password-min-8-chars>

# --- container settings (defaults, adjust if needed) ---
DEBUG=False
USE_SQLITE=False
DB_NAME=pixora
DB_USER=pixora
DB_HOST=database
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8282,http://127.0.0.1:8282
MAX_IMAGE_SIZE_MB=5
MEDIA_ROOT=/app/media
MEDIA_URL=/media/